NODE_ENV=production
PORT=5000
DATABASE_URL=postgresql://bms:bms123@postgres:5432/bookmyshow
REDIS_URL=redis://redis:6379

# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

CORS_ORIGIN=http://localhost:8080
TRUST_PROXY=1
SEAT_HOLD_SECONDS=300

# Demo only: tickets are free in this mode
PAYMENT_MODE=mock
ALLOW_DEMO_PAYMENTS=true

# Optional. Without a key the chatbot is off and recommendations use fallback
AI_API_KEY=
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AI_MODEL=gemini-3.1-flash-lite
AI_FALLBACK_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.5-flash-lite